<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:checkable="false"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemName"
                style="@style/Text.FastTrack.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="4 × Hard cider" />

            <TextView
                android:id="@+id/itemSubtitle"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="12 fl oz each · beer · estimate" />

            <TextView
                android:id="@+id/itemBadges"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                tools:text="LOW confidence · estimated" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemCalories"
                style="@style/Text.FastTrack.Metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="720" />

            <TextView
                android:id="@+id/itemCalorieRange"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="640–800 kcal" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteItem"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_delete"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
