<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingText"
                    style="@style/Text.FastTrack.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_greeting" />

                <TextView
                    android:id="@+id/nameText"
                    style="@style/Text.FastTrack.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Keny" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/streakChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/accent_fasting_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_flame"
                    app:tint="@color/accent_fasting" />

                <TextView
                    android:id="@+id/streakValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/accent_fasting"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="5" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_profile"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_profile"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>

        <!-- Day navigator: arrow back to review how past days went (read-only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashPrevDay"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/day_prev"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_chevron_left"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/dashDayLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashNextDay"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/day_next"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Fasting hero card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/fastingHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/fastingHeroTitle"
                        android:text="@string/dash_fasting_card"
                        android:textColor="@color/brand_ink"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/fastingProtocolChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="#33000000"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/brand_ink"
                        android:textSize="12sp"
                        tools:text="16:8" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fastingStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.75"
                    android:textColor="@color/brand_ink"
                    android:textSize="13sp"
                    tools:text="Elapsed" />

                <TextView
                    android:id="@+id/fastingTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_ink"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="07:24:10" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/fastingProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="@color/brand_ink"
                    app:trackColor="#33000000"
                    app:trackCornerRadius="8dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="8dp"
                    tools:progress="45" />

                <TextView
                    android:id="@+id/fastingStageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/brand_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Fat Burning Begins · Catabolic"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fastingActionButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/brand_ink"
                    android:textColor="@color/brand_gold"
                    android:text="@string/fasting_start" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Today's snapshot (the daily update itself is a once-a-day popup; revisit in Profile) -->
        <TextView
            android:id="@+id/todayTitle"
            style="@style/Text.FastTrack.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/dash_today" />

        <!-- Row: Hydration + Nutrition -->
        <LinearLayout
            android:id="@+id/todayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <!-- Hydration -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/waterCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_water"
                        app:tint="@color/accent_water" />

                    <TextView
                        android:id="@+id/waterValue"
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="48 / 96 oz" />

                    <TextView
                        android:id="@+id/waterInsight"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="3 glasses to goal" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/waterProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:indicatorColor="@color/accent_water"
                        app:trackCornerRadius="6dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp"
                        tools:progress="50" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Energy balance (merged with nutrition): intake toward goal + net in/out -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/energyCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/accent_fasting" />

                        <TextView
                            android:id="@+id/energyStateChip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/accent_fasting"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Deficit" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/energyNetValue"
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/accent_fasting"
                        tools:text="−540 kcal" />

                    <TextView
                        android:id="@+id/energyBreakdown"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="1,240 in · 1,780 out" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/energyProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:indicatorColor="@color/accent_nutrition"
                        app:trackCornerRadius="6dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp"
                        tools:progress="65" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Recovery readiness from Garmin (hidden without recent wellness data) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recoveryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/recoveryRing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="100"
                            app:indicatorSize="52dp"
                            app:trackThickness="5dp"
                            app:trackCornerRadius="4dp"
                            tools:progress="72" />

                        <TextView
                            android:id="@+id/recoveryScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="72" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recoveryHeadline"
                            style="@style/Text.FastTrack.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="You're well recovered" />

                        <TextView
                            android:id="@+id/recoveryFactors"
                            style="@style/Text.FastTrack.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Body Battery 78 · Sleep 7.6h · Stress 24" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/recoveryFasting"
                    style="@style/Text.FastTrack.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="Fasting: Good day for your full fast." />

                <TextView
                    android:id="@+id/recoveryTraining"
                    style="@style/Text.FastTrack.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="Training: Green light for intensity." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily mood / energy / hunger check-in -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/checkInCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="@dimen/icon_badge_size"
                    android:layout_height="@dimen/icon_badge_size"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/accent_water_container">

                    <TextView
                        android:id="@+id/checkInEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textSize="20sp"
                        tools:text="🙂" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/checkInTitle"
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="How are you feeling?" />

                    <TextView
                        android:id="@+id/checkInBody"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="A 5-second mood, energy and hunger check-in." />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Movement: weekly distance over time + category breakdown -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/movementCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_exercise"
                        app:tint="@color/accent_exercise" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/dash_exercise_card"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/movementTrend"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="+8% vs last week" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/movementToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:checkedButton="@+id/toggleToday"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggleToday"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/dash_movement_today"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggleWeek"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/dash_movement_week"
                        android:textSize="13sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/movementWeekTotal"
                    style="@style/Text.FastTrack.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/accent_exercise"
                    tools:text="12.4 mi this week" />

                <TextView
                    android:id="@+id/movementTodaySub"
                    style="@style/Text.FastTrack.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="32 min · 410 kcal today" />

                <ai.anthracite.fasttrack.ui.widget.TrendChartView
                    android:id="@+id/movementChart"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="10dp"
                    app:tcvAccent="@color/accent_exercise"
                    app:tcvMode="bar" />

                <!-- Category breakdown rows injected at runtime -->
                <LinearLayout
                    android:id="@+id/movementCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/movementEmpty"
                    style="@style/Text.FastTrack.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/dash_movement_empty"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weight trend (only shown once the user logs a weigh-in) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_weight"
                        app:tint="@color/accent_fasting" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/weight_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weightTrend"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Down 2.0 lb this week" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weightValue"
                    style="@style/Text.FastTrack.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/accent_fasting"
                    tools:text="208 lb" />

                <ai.anthracite.fasttrack.ui.widget.TrendChartView
                    android:id="@+id/weightSpark"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    app:tcvAccent="@color/accent_fasting"
                    app:tcvMode="line" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Week-one+ goal sketch -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/projectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/accent_fasting_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/projectionTitle"
                    style="@style/Text.FastTrack.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_fasting"
                    tools:text="You could hit 165 lb around Nov 18" />

                <TextView
                    android:id="@+id/projectionBody"
                    style="@style/Text.FastTrack.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="At about 1 lb a week, that's closer than it feels." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Read-only recap for a past day (shown only when arrowed back) -->
        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Day score -->
                    <TextView
                        android:id="@+id/histScoreHeadline"
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="3 of 4 goals closed" />

                    <TextView
                        android:id="@+id/histScoreLine"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="Strong, steady day — almost a clean sweep." />

                    <!-- Goal rings (populated at runtime) -->
                    <LinearLayout
                        android:id="@+id/histRings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />

                    <!-- 7-day consistency strip -->
                    <TextView
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/dash_last_7_days" />

                    <LinearLayout
                        android:id="@+id/histStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/histRecapHeadline"
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        tools:text="A solid, steady day" />

                    <TextView
                        android:id="@+id/histRecapSummary"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="You hit your hydration goal and stayed in a deficit." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.FastTrack.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dash_fasting_card" />

                        <TextView
                            android:id="@+id/histFasting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Fasted 16h 20m · goal met ✓" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/histWaterRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/Text.FastTrack.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dash_water_card" />

                        <TextView
                            android:id="@+id/histHydration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="64 / 96 oz" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Edit water"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/histEnergyRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/Text.FastTrack.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dash_energy_balance" />

                        <TextView
                            android:id="@+id/histEnergy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Net −540 kcal" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Edit food"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.FastTrack.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dash_exercise_card" />

                        <TextView
                            android:id="@+id/histMovement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="32 min · 410 kcal" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
