<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_coach_avatar"
        android:contentDescription="@string/coach_title"
        android:padding="7dp"
        android:src="@drawable/ic_flame"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_coach_assistant"
        android:lineSpacingMultiplier="1.2"
        android:maxWidth="300dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        tools:text="Break the fast with protein and a little salt." />
</LinearLayout>
