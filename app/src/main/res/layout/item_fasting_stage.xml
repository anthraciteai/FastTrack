<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <!-- Timeline column: connector line behind, node circle on top -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/stageConnector"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="?attr/colorOutlineVariant" />

        <FrameLayout
            android:id="@+id/stageNode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="?attr/colorSurfaceVariant">

            <ImageView
                android:id="@+id/stageIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOutline"
                tools:src="@drawable/ic_flame" />
        </FrameLayout>
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Ketosis Begins" />

            <TextView
                android:id="@+id/stageNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/accent_fasting"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="NOW"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/stageHour"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="12h" />
        </LinearLayout>

        <TextView
            android:id="@+id/stageBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_fasting"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Fat burning" />

        <TextView
            android:id="@+id/stageDesc"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.1"
            tools:text="Your liver starts converting fat into ketones." />
    </LinearLayout>
</LinearLayout>
