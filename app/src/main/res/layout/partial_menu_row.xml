<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="@dimen/icon_badge_size"
        android:layout_height="@dimen/icon_badge_size"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="?attr/colorPrimaryContainer">

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnPrimaryContainer" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/menuTitle"
            style="@style/Text.FastTrack.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Settings" />

        <TextView
            android:id="@+id/menuSubtitle"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Units, reminders" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
