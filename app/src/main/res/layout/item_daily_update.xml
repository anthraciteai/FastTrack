<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/updateDate"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            tools:text="Monday October 19th" />

        <TextView
            android:id="@+id/updateHeadline"
            style="@style/Text.FastTrack.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Strong day" />

        <TextView
            android:id="@+id/updateSummary"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.15"
            tools:text="You slept a solid 7.4h and played soccer for 109 min. Stress stayed low." />

        <TextView
            android:id="@+id/updateRecs"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone"
            tools:text="• Build mileage gradually — aim for 13.6 mi\n• Hydrate earlier in the day"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/updateStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:textColor="@color/accent_fasting"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_flame"
            app:drawableTint="@color/accent_fasting"
            tools:text="Day 5 streak" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
