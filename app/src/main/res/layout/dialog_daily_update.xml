<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <TextView
            style="@style/Text.FastTrack.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dash_today" />

        <TextView
            android:id="@+id/duDate"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Thursday October 22nd" />

        <TextView
            android:id="@+id/duStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:textColor="@color/accent_fasting"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_flame"
            app:drawableTint="@color/accent_fasting"
            tools:text="Day 5 streak · showing up counts" />

        <!-- Recap: how your most recent day went -->
        <LinearLayout
            android:id="@+id/duRecapSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/duRecapDate"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                tools:text="Yesterday" />

            <TextView
                android:id="@+id/duRecapHeadline"
                style="@style/Text.FastTrack.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Strong day" />

            <TextView
                android:id="@+id/duRecapSummary"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingMultiplier="1.15"
                tools:text="You slept a solid 7.4h and played soccer. Stress stayed low." />

            <LinearLayout
                android:id="@+id/duRecapStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- AI coach note: the personalized daily update (shown when on-device AI is enabled) -->
        <LinearLayout
            android:id="@+id/duCoachSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.FastTrack.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/dash_focus_today" />

            <ProgressBar
                android:id="@+id/duCoachLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp" />

            <TextView
                android:id="@+id/duCoachNote"
                style="@style/Text.FastTrack.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone"
                tools:text="Hey Keny, you had a solid day with steady movement and low stress!" />
        </LinearLayout>

        <!-- Recommendations: your focus today -->
        <LinearLayout
            android:id="@+id/duRecsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                style="@style/Text.FastTrack.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/dash_focus_today" />

            <LinearLayout
                android:id="@+id/duRecsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Weekly review is ready (Sun–Tue, until opened) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/duWeeklyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/accent_fasting_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/accent_fasting" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.FastTrack.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your weekly review is ready"
                        android:textColor="@color/accent_fasting" />

                    <TextView
                        android:id="@+id/duWeeklyHeadline"
                        style="@style/Text.FastTrack.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="5 fasts completed · 1.2 lb down — a strong week" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duChatButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/daily_update_chat_coach"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:text="Let's go"
            android:textSize="16sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
