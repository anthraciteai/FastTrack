<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/leadingBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle"
        android:backgroundTint="@color/accent_water_container">

        <ImageView
            android:id="@+id/leadingIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_water"
            app:tint="@color/accent_water" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            style="@style/Text.FastTrack.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Water" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/Text.FastTrack.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="9:40 AM" />
    </LinearLayout>

    <TextView
        android:id="@+id/valueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:textSize="15sp"
        tools:text="12 oz" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteButton"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_delete"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
