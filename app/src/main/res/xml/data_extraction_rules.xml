<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fasttrack.db" />
        <include domain="database" path="fasttrack.db-wal" />
        <include domain="database" path="fasttrack.db-shm" />
        <include domain="sharedpref" path="fasttrack_prefs.xml" />
        <include domain="file" path="fasttrack-snapshot.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="fasttrack-snapshot.json" />
    </device-transfer>
</data-extraction-rules>
